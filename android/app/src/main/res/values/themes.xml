<resources xmlns:app="http://schemas.android.com/apk/res-auto">
    <style name="Theme.PhoneBridge" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#8FF0C4</item>
        <item name="colorPrimaryVariant">#63B78D</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="colorSecondary">#FFC86B</item>
        <item name="colorOnSurface">#F2F7F2</item>
        <item name="android:statusBarColor">#07100D</item>
        <item name="android:navigationBarColor">#07100D</item>
        <item name="android:windowBackground">#07100D</item>
    </style>
    <style name="MetricChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#B9D8C9</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="PetAction">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:background">@drawable/bg_action</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginEnd">7dp</item>
        <item name="backgroundTint">#10201A</item>
        <item name="android:minWidth">68dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#D8F5E7</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="AppearanceSelector" parent="PetAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">12dp</item>
        <item name="iconPadding">4dp</item>
        <item name="iconTint">@color/appearance_selector_icon</item>
    </style>
</resources>
